
# Configuração do Ambiente
VITE_INSTANCE_NAME="Pet InfoCare Production"

# Banco de Dados (Supabase)
# Crie um projeto em https://supabase.com e pegue estas credenciais
VITE_SUPABASE_URL=https://sua-url-do-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# Configurações de IA (Opcional)
VITE_ENABLE_GOOGLE_AI=false
API_KEY=sua_chave_gemini_api
